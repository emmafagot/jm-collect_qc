config {
  type: "table",
  database: "jm-collect",
  schema: "trema_dataform",
  tags: ["trema"],
  name: "trema_step2_union",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["data_source", "account_id"],
    labels: { client: "trema" }
  },
  description: "Client: Trema. Union step - every Trema source for the processing window, standard columns only. Window only, rebuilt every run."
}

-- Each source is selected BY COLUMN NAME (media.selectStandardColumns), so a source
-- model returning its columns in another order cannot shift values.
-- To add a source: create trema_step1_<source>.sqlx and add its name below.

${
  ["trema_step1_miq"]
    .map(name => media.selectStandardColumns(ref({schema: "trema_dataform", name})))
    .join("\n\nUNION ALL\n\n")
}
