config {
  type: "table",
  database: "jm-collect",
  schema: "unibroue_dataform",
  tags: ["unibroue"],
  name: "unibroue_step2_union",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["data_source", "account_id"],
    labels: { client: "unibroue" }
  },
  description: "Client: Unibroue. Union step - every Unibroue source for the processing window, standard columns only. Replaces unibroue_sr_etl.union_media (window only, rebuilt every run)."
}

-- Each source is selected BY COLUMN NAME (media.selectStandardColumns), so a source
-- model returning its columns in another order cannot shift values.
-- To add a source: create unibroue_step1_<source>.sqlx and add its name below.

${
  ["unibroue_step1_cm360",
   "unibroue_step1_meta"]
    .map(name => media.selectStandardColumns(ref({schema: "unibroue_dataform", name})))
    .join("\n\nUNION ALL\n\n")
}
