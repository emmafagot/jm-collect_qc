config {
  type: "table",
  database: "jm-collect",
  schema: "cozey_dataform",
  tags: ["cozey"],
  name: "cozey_step2_union",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["data_source", "account_id"],
    labels: { client: "cozey" }
  },
  description: "Client: Cozey. Union step - every Cozey source for the processing window, standard columns only. Window only, rebuilt every run."
}

-- Each source is selected BY COLUMN NAME (media.selectStandardColumns), so a source
-- model returning its columns in another order cannot shift values.
-- To add a source: create cozey_step1_<source>.sqlx and add its name below.

${
  ["cozey_step1_cm360",
   "cozey_step1_yahoo"]
    .map(name => media.selectStandardColumns(ref({schema: "cozey_dataform", name})))
    .join("\n\nUNION ALL\n\n")
}
