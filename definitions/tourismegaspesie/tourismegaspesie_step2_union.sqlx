config {
  type: "table",
  database: "jm-collect",
  schema: "tourismegaspesie_dataform",
  tags: ["tourismegaspesie"],
  name: "tourismegaspesie_step2_union",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["data_source", "account_id"],
    labels: { client: "tourismegaspesie" }
  },
  description: "Client: Tourisme Gaspésie. Union step - every Tourisme Gaspésie source for the processing window, standard columns only. Window only, rebuilt every run."
}

-- Each source is selected BY COLUMN NAME (media.selectStandardColumns), so a source
-- model returning its columns in another order cannot shift values.
-- To add a source: create tourismegaspesie_step1_<source>.sqlx and add its name below.

${
  ["tourismegaspesie_step1_cm360",
   "tourismegaspesie_step1_yahoo"]
    .map(name => media.selectStandardColumns(ref({schema: "tourismegaspesie_dataform", name})))
    .join("\n\nUNION ALL\n\n")
}
