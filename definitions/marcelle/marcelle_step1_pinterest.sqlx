config {
  type: "table",
  database: "jm-collect",
  schema: "marcelle_dataform",
  tags: ["marcelle"],
  name: "marcelle_step1_pinterest",
  bigquery: { labels: { client: "marcelle" } },
  description: "Client: Groupe Marcelle. Source step - Pinterest delivery for the processing window (campaign / ad group level, no creative level), mapped to the standard columns (includes/media.js). Port of the PIN CTE of marcelle_dash_ah_last_days."
}

-- Rows kept: cost > 0, inside the processing window.
-- The Pinterest table has no ad level: every level 3 column is empty.

SELECT
  date                                                    AS date,
  'pinterest'                                             AS data_source,
  COALESCE(CAST(account_id AS STRING), '')                AS account_id,
  COALESCE(account_name, '')                              AS account,
  COALESCE(CAST(account_id AS STRING), '')                AS advertiser_id,
  COALESCE(account_name, '')                              AS advertiser,
  COALESCE(CAST(campaign_id AS STRING), '')               AS level_1_id,
  COALESCE(campaign_name, '')                             AS level_1,
  COALESCE(CAST(ad_group_id AS STRING), '')               AS level_2_id,
  COALESCE(ad_group_name, '')                             AS level_2,
  ''                                                      AS level_3_id,
  ''                                                      AS level_3,
  ''                                                      AS plt_publisher_id,
  ''                                                      AS plt_publisher,
  ''                                                      AS campaign_type,
  COALESCE(currency, '')                                  AS currency,

  -- ------------------------------------------------------------ Campaign name tokens --
  functions.jm_tax_split(campaign_name, 0)                AS client,
  functions.jm_tax_split(campaign_name, 1)                AS l1_lob,
  functions.jm_tax_split(campaign_name, 2)                AS campaign_identifier,
  functions.jm_tax_split(campaign_name, 3)                AS l1_objective,
  functions.jm_tax_split(campaign_name, 4)                AS l1_year,
  functions.jm_tax_split(campaign_name, 5)                AS external_id,
  functions.jm_tax_split(campaign_name, 6)                AS billing_id,

  -- ---------------------------------------------------------- Ad group name tokens --
  functions.jm_tax_split(ad_group_name, 0)                AS l2_objective,
  functions.jm_tax_split(ad_group_name, 1)                AS l2_product,
  functions.jm_tax_split(ad_group_name, 2)                AS l2_lob,
  functions.jm_tax_split(ad_group_name, 3)                AS l2_campaign_identifier,
  functions.jm_tax_split(ad_group_name, 4)                AS publisher,
  functions.jm_tax_split(ad_group_name, 5)                AS channel,
  -- Token 6 is "<inventory>_<placement location>" or just the placement location.
  IF(STRPOS(functions.jm_tax_split(ad_group_name, 6), '_') > 0,
     TRIM(SPLIT(LOWER(functions.jm_tax_split(ad_group_name, 6)), '_')[SAFE_OFFSET(1)]),
     functions.jm_tax_split(ad_group_name, 6))            AS placement_location,
  functions.jm_tax_split(ad_group_name, 7)                AS audience,
  functions.jm_tax_split(ad_group_name, 8)                AS l2_language,
  functions.jm_tax_split(ad_group_name, 9)                AS targeting,
  functions.jm_tax_split(ad_group_name, 10)               AS targeting_details,
  functions.jm_tax_split(ad_group_name, 11)               AS market,
  functions.jm_tax_split(ad_group_name, 12)               AS market_details,
  functions.jm_tax_split(ad_group_name, 13)               AS device,
  functions.jm_tax_split(ad_group_name, 14)               AS buying_type,
  functions.jm_tax_split(ad_group_name, 15)               AS l2_creative_grouping,
  IF(STRPOS(functions.jm_tax_split(ad_group_name, 6), '_') > 0,
     TRIM(SPLIT(LOWER(functions.jm_tax_split(ad_group_name, 6)), '_')[SAFE_OFFSET(0)]),
     '')                                                  AS inventory,

  -- ------------------------------------------------------ No creative level available --
  ''                                                      AS creative_product_message,
  ''                                                      AS version,
  ''                                                      AS format,
  ''                                                      AS format_details,
  ''                                                      AS l3_language,
  ''                                                      AS l3_creative_grouping,
  ''                                                      AS cta,
  ''                                                      AS creative_flight_dates,
  ''                                                      AS l3_campaign_identifier,
  ''                                                      AS l3_lob,

  -- --------------------------------------------------------------------- Metrics --
  SUM(COALESCE(cost, 0))                                  AS media_spend,
  SUM(COALESCE(impressions_paid, 0))                      AS impressions,
  SUM(COALESCE(outbound_clicks_paid, 0))                  AS clicks,

  SUM(COALESCE(video_p_25_combined_1, 0))                 AS video_completion_25,
  SUM(COALESCE(video_p_50_combined_1, 0))                 AS video_completion_50,
  SUM(COALESCE(video_p_75_combined_1, 0))                 AS video_completion_75,
  SUM(COALESCE(video_p_95_combined_1, 0))                 AS video_completion_95,
  SUM(COALESCE(video_p_100_complete_1, 0))                AS video_completion_100,
  -- Views: MRC video views.
  SUM(COALESCE(video_mrc_views_1, 0))                     AS video_views,

  0                                                       AS audio_completion_25,
  0                                                       AS audio_completion_50,
  0                                                       AS audio_completion_75,
  0                                                       AS audio_completion_100,
  0                                                       AS audio_views,

  0                                                       AS post_likes,
  SUM(COALESCE(engagements_paid, 0))                      AS post_engagements,
  0                                                       AS post_reactions,
  0                                                       AS post_comments,
  SUM(COALESCE(saves_paid, 0))                            AS post_saves,
  0                                                       AS post_shares,
  SUM(COALESCE(carousel_swipes_paid, 0))                  AS carousel_swipes,
  0                                                       AS follows,
  0                                                       AS lost_impressions,
  0                                                       AS available_impressions,
  0                                                       AS viewable_impressions,
  0                                                       AS measurable_impressions

FROM ${ref({schema: marcelle_config.sourceDataset, name: "PIA_PIN_SR"})}
WHERE date >= ${marcelle_config.windowStart}
  AND cost > 0
GROUP BY ALL
