config {
  type: "table",
  database: "jm-collect",
  schema: "intelcom_dataform",
  tags: ["intelcom"],
  name: "intelcom_step2_union",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["data_source", "account_id"],
    labels: { client: "intelcom" }
  },
  description: "Client: Intelcom Dragonfly. Union step - every Intelcom Dragonfly source for the processing window, standard columns only. Window only, rebuilt every run."
}

-- Each source is selected BY COLUMN NAME (media.selectStandardColumns), so a source
-- model returning its columns in another order cannot shift values.
-- To add a source: create intelcom_step1_<source>.sqlx and add its name below.

${
  ["intelcom_step1_miq",
   "intelcom_step1_googleads_l1"]
    .map(name => media.selectStandardColumns(ref({schema: "intelcom_dataform", name})))
    .join("\n\nUNION ALL\n\n")
}
