config {
  type: "table",
  database: "jm-collect",
  schema: "montoni_dataform",
  tags: ["montoni"],
  name: "montoni_step1_yahoo",
  bigquery: { labels: { client: "montoni" } },
  description: "Client: Le Groupe Montoni. Source step - Yahoo DSP delivery for the processing window, mapped to the standard columns (includes/media.js). Yahoo uses its own naming layout (campaign / line). Same model as montoni_step1_yahoo (client never built in BigQuery before Dataform)."
}

-- Rows kept: cost > 0, inside the processing window.

SELECT
  date                                                    AS date,
  'yahoo'                                                 AS data_source,
  '${montoni_config.yahooAccountId}'                     AS account_id,
  '${montoni_config.yahooAccountName}'                   AS account,
  COALESCE(CAST(advertiser_id AS STRING), '')             AS advertiser_id,
  COALESCE(advertiser, '')                                AS advertiser,
  COALESCE(CAST(campaign_id AS STRING), '')               AS level_1_id,
  COALESCE(campaign, '')                                  AS level_1,
  COALESCE(CAST(line_id AS STRING), '')                   AS level_2_id,
  COALESCE(line, '')                                      AS level_2,
  COALESCE(CAST(creative_id AS STRING), '')               AS level_3_id,
  COALESCE(creative, '')                                  AS level_3,
  ''                                                      AS plt_publisher_id,
  ''                                                      AS plt_publisher,
  ''                                                      AS campaign_type,
  COALESCE(advertiser_currency, '')                       AS currency,

  -- ------------------------------------------- Campaign name tokens (Yahoo layout) --
  -- Not extracted: token 5 market, 6 flight, 7 device, 8 format.
  functions.jm_tax_split(campaign, 1)                     AS client,
  functions.jm_tax_split(campaign, 4)                     AS l1_lob,
  functions.jm_tax_split(campaign, 2)                     AS campaign_identifier,
  functions.jm_tax_split(campaign, 3)                     AS l1_objective,
  ''                                                      AS l1_year,
  functions.jm_tax_split(campaign, 10)                    AS external_id,
  functions.jm_tax_split(campaign, 0)                     AS billing_id,

  -- --------------------------------------------------------------- Line name tokens --
  functions.jm_tax_split(line, 0)                         AS l2_objective,
  functions.jm_tax_split(line, 1)                         AS l2_product,
  functions.jm_tax_split(line, 2)                         AS l2_lob,
  functions.jm_tax_split(line, 3)                         AS l2_campaign_identifier,
  functions.jm_tax_split(line, 4)                         AS publisher,
  functions.jm_tax_split(line, 5)                         AS channel,
  functions.jm_tax_split(line, 6)                         AS placement_location,
  functions.jm_tax_split(line, 7)                         AS audience,
  functions.jm_tax_split(line, 8)                         AS l2_language,
  functions.jm_tax_split(line, 9)                         AS targeting,
  functions.jm_tax_split(line, 10)                        AS targeting_details,
  functions.jm_tax_split(line, 11)                        AS market,
  functions.jm_tax_split(line, 12)                        AS market_details,
  functions.jm_tax_split(line, 13)                        AS device,
  functions.jm_tax_split(line, 14)                        AS buying_type,
  functions.jm_tax_split(line, 15)                        AS l2_creative_grouping,
  functions.jm_tax_split(campaign, 9)                     AS inventory,

  -- ------------------------------------------ Creative level (taken from the line) --
  ''                                                      AS creative_product_message,
  ''                                                      AS version,
  functions.jm_tax_split(line, 16)                        AS format,
  ''                                                      AS format_details,
  ''                                                      AS l3_language,
  functions.jm_tax_split(line, 15)                        AS l3_creative_grouping,
  ''                                                      AS cta,
  ''                                                      AS creative_flight_dates,
  ''                                                      AS l3_campaign_identifier,
  ''                                                      AS l3_lob,

  -- --------------------------------------------------------------------- Metrics --
  SUM(COALESCE(cost, 0))                                  AS media_spend,
  SUM(COALESCE(impressions, 0))                           AS impressions,
  SUM(COALESCE(clicks, 0))                                AS clicks,

  SUM(COALESCE(video_completions_25, 0))                  AS video_completion_25,
  SUM(COALESCE(video_completions_50, 0))                  AS video_completion_50,
  SUM(COALESCE(video_completions_75, 0))                  AS video_completion_75,
  0                                                       AS video_completion_95,
  SUM(COALESCE(video_completions, 0))                     AS video_completion_100,
  -- Views: 0, as for every Yahoo client (Yahoo "video_views" are starts, not views).
  0                                                       AS video_views,

  0                                                       AS audio_completion_25,
  0                                                       AS audio_completion_50,
  0                                                       AS audio_completion_75,
  0                                                       AS audio_completion_100,
  0                                                       AS audio_views,

  0                                                       AS post_likes,
  0                                                       AS post_engagements,
  0                                                       AS post_reactions,
  0                                                       AS post_comments,
  0                                                       AS post_saves,
  0                                                       AS post_shares,
  0                                                       AS carousel_swipes,
  0                                                       AS follows,
  0                                                       AS lost_impressions,
  0                                                       AS available_impressions,
  SUM(COALESCE(viewable_impressions, 0))                  AS viewable_impressions,
  SUM(COALESCE(measurable_impressions, 0))                AS measurable_impressions

FROM ${ref({schema: montoni_config.sourceDataset, name: "VDSP_YAH_SR"})}
WHERE date >= ${montoni_config.windowStart}
  AND cost > 0
GROUP BY ALL
