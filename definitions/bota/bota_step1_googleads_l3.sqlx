config {
  type: "table",
  database: "jm-collect",
  schema: "bota_dataform",
  tags: ["bota"],
  name: "bota_step1_googleads_l3",
  bigquery: { labels: { client: "bota" } },
  description: "Client: Bota Bota. Source step - Google Ads ad-level delivery (campaign types of bota_config.googleAdsL3ChannelTypes, e.g. Display / Demand Gen / Video) for the processing window, mapped to the standard columns (includes/media.js). Modelled on the GAD3 CTE of sepaq_dash_ah_last_days (cm-collect)."
}

-- Rows kept: cost > 0, campaign types in bota_config.googleAdsL3ChannelTypes, inside the
-- processing window. GADL3 also holds the Search campaigns: they are read at campaign
-- level by bota_step1_googleads_l1 only, so the two type lists must not overlap.
-- Standard naming convention (same token positions as CM360 / Meta): campaign name
-- (level 1), ad group name (level 2, placement layout), ad name (level 3, creative
-- layout). The ad name is image_ad_name (empty for text ads). level_2 = ad group NAME
-- (the sepaq query puts the ad group id there).

SELECT
  date                                                    AS date,
  'googleads_l3'                                          AS data_source,
  COALESCE(profile_id, '')                                AS account_id,
  COALESCE(profile, '')                                   AS account,
  COALESCE(profile_id, '')                                AS advertiser_id,
  COALESCE(profile, '')                                   AS advertiser,
  COALESCE(campaign_id, '')                               AS level_1_id,
  COALESCE(campaign_name, '')                             AS level_1,
  COALESCE(CAST(ad_group_id AS STRING), '')               AS level_2_id,
  COALESCE(ad_group_name, '')                             AS level_2,
  COALESCE(CAST(ad_id AS STRING), '')                     AS level_3_id,
  COALESCE(image_ad_name, '')                             AS level_3,
  ''                                                      AS plt_publisher_id,
  -- Google network the ad ran on (YouTube, Display Network...).
  COALESCE(network, '')                                   AS plt_publisher,
  COALESCE(advertising_channel_type, '')                  AS campaign_type,
  COALESCE(currency, '')                                  AS currency,

  -- ------------------------------------------------------------ Campaign name tokens --
  functions.jm_tax_split(campaign_name, 0)                AS client,
  functions.jm_tax_split(campaign_name, 1)                AS l1_lob,
  functions.jm_tax_split(campaign_name, 2)                AS campaign_identifier,
  functions.jm_tax_split(campaign_name, 3)                AS l1_objective,
  functions.jm_tax_split(campaign_name, 4)                AS l1_year,
  functions.jm_tax_split(campaign_name, 5)                AS external_id,
  functions.jm_tax_split(campaign_name, 6)                AS billing_id,

  -- ------------------------------------------------------------ Ad group name tokens --
  functions.jm_tax_split(ad_group_name, 0)                AS l2_objective,
  functions.jm_tax_split(ad_group_name, 1)                AS l2_product,
  functions.jm_tax_split(ad_group_name, 2)                AS l2_lob,
  functions.jm_tax_split(ad_group_name, 3)                AS l2_campaign_identifier,
  functions.jm_tax_split(ad_group_name, 4)                AS publisher,
  functions.jm_tax_split(ad_group_name, 5)                AS channel,
  functions.jm_tax_split(ad_group_name, 6)                AS placement_location,
  functions.jm_tax_split(ad_group_name, 7)                AS audience,
  functions.jm_tax_split(ad_group_name, 8)                AS l2_language,
  functions.jm_tax_split(ad_group_name, 9)                AS targeting,
  functions.jm_tax_split(ad_group_name, 10)               AS targeting_details,
  functions.jm_tax_split(ad_group_name, 11)               AS market,
  functions.jm_tax_split(ad_group_name, 12)               AS market_details,
  functions.jm_tax_split(ad_group_name, 13)               AS device,
  functions.jm_tax_split(ad_group_name, 14)               AS buying_type,
  functions.jm_tax_split(ad_group_name, 15)               AS l2_creative_grouping,
  -- Inventory = the Google network.
  COALESCE(network, '')                                   AS inventory,

  -- ----------------------------------------------------------------- Ad name tokens --
  functions.jm_tax_split(image_ad_name, 0)                AS creative_product_message,
  functions.jm_tax_split(image_ad_name, 1)                AS version,
  functions.jm_tax_split(image_ad_name, 2)                AS format,
  functions.jm_tax_split(image_ad_name, 3)                AS format_details,
  functions.jm_tax_split(image_ad_name, 4)                AS l3_language,
  functions.jm_tax_split(image_ad_name, 5)                AS l3_creative_grouping,
  functions.jm_tax_split(image_ad_name, 6)                AS cta,
  functions.jm_tax_split(image_ad_name, 7)                AS creative_flight_dates,
  functions.jm_tax_split(image_ad_name, 8)                AS l3_campaign_identifier,
  functions.jm_tax_split(image_ad_name, 9)                AS l3_lob,

  -- --------------------------------------------------------------------- Metrics --
  SUM(COALESCE(cost, 0))                                  AS media_spend,
  SUM(COALESCE(impressions, 0))                           AS impressions,
  SUM(COALESCE(clicks, 0))                                AS clicks,

  SUM(COALESCE(video_quartile_25_views, 0))               AS video_completion_25,
  SUM(COALESCE(video_quartile_50_views, 0))               AS video_completion_50,
  SUM(COALESCE(video_quartile_75_views, 0))               AS video_completion_75,
  0                                                       AS video_completion_95,
  SUM(COALESCE(video_quartile_100_views, 0))              AS video_completion_100,
  -- Views: Google Ads video views.
  SUM(COALESCE(videoviews, 0))                            AS video_views,

  0                                                       AS audio_completion_25,
  0                                                       AS audio_completion_50,
  0                                                       AS audio_completion_75,
  0                                                       AS audio_completion_100,
  0                                                       AS audio_views,

  0                                                       AS post_likes,
  SUM(COALESCE(engagements, 0))                           AS post_engagements,
  0                                                       AS post_reactions,
  0                                                       AS post_comments,
  0                                                       AS post_saves,
  0                                                       AS post_shares,
  0                                                       AS carousel_swipes,
  0                                                       AS follows,
  -- Not available at ad level.
  0                                                       AS lost_impressions,
  0                                                       AS available_impressions,
  SUM(COALESCE(active_view_impressions, 0))               AS viewable_impressions,
  SUM(COALESCE(active_view_measurable_impressions, 0))    AS measurable_impressions

FROM ${ref({schema: bota_config.sourceDataset, name: "GOOGLEADS_GADL3_SR"})}
WHERE date >= ${bota_config.windowStart}
  AND cost > 0
  AND LOWER(advertising_channel_type) IN (${bota_config.googleAdsL3ChannelTypes.map(t => `'${t}'`).join(", ")})
GROUP BY ALL
